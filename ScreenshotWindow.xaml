<Window x:Class="YMM4_Snipping_Tool.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YMM4_Snipping_Tool"
        mc:Ignorable="d"
        Title="ScreenshotWindow" Height="450" Width="800"
        Opacity="0.5"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowState="Maximized"
        MouseDown="RunMouseDown"
        KeyDown="RunShiftDown"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}">
    <Grid Name="RootGrid">
        <Canvas Name="MainCanvas"></Canvas>
    </Grid>
</Window>
